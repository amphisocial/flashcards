{
  "name": "athenaboard",
  "version": "0.1.0",
  "private": true,
  "description": "AthenaBoard — the AI whiteboard that turns a teacher's explanation into a live simulation. Grades 5–9 Math, Science, Geography and History.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "NODE_ENV=development node server/server.js",
    "build:lessons": "node scripts/build-lesson-pages.js",
    "migrate": "node scripts/migrate-to-postgres.js",
    "test": "npm run test:graph && npm run test:board",
    "test:graph": "node scripts/test-graphdemo.js",
    "test:board": "node scripts/test-board-ui.js",
    "test:db": "node scripts/test-db-layer.js",
    "test:membership": "node scripts/test-membership.js",
    "test:marketing": "node scripts/smoke-marketing.js",
    "test:all": "npm run test:graph && npm run test:board && npm run test:db && npm run test:membership && npm run test:marketing"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "stripe": "^16.0.0",
    "ws": "^8.18.0"
  },
  "license": "UNLICENSED"
}
